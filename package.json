{
  "name": "aj-videditor",
  "version": "0.1.0",
  "description": "初期微動継続時間 - ブラウザで動く動画編集ツール",
  "scripts": {
    "dev": "concurrently \"npm run watch\" \"npx serve .\"",
    "build": "esbuild src/main.ts --bundle --outfile=dist/main.js --format=esm --target=es2020",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/main.js --format=esm --target=es2020 --watch",
    "serve": "npx serve ."
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
